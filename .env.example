# LLM API Key（必填，任意 OpenAI 兼容服务：DeepSeek 官方 / 硅基流动 / OneAPI / vLLM 等）
OPENAI_API_KEY=sk-xxxxxxxx
# OpenAI 兼容网关地址（示例）:
#   DeepSeek 官方:  https://api.deepseek.com/v1
#   硅基流动:      https://api.siliconflow.cn/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型分档路由（strong: 规划/质检/综合；cheap: 组长/摘要）
# 注意: 模型名必须与网关一致，例如硅基流动为 deepseek-ai/DeepSeek-V3 格式
# STRONG_MODEL=deepseek-chat
# CHEAP_MODEL=deepseek-chat

# 可选：Tavily 联网搜索（不填则使用内置模拟搜索结果，支持离线演示）
# TAVILY_API_KEY=tvly-xxxxxxxx

# 可选：Embedding API（OpenAI 兼容 /v1/embeddings，用于知识库向量召回）
# 不填则自动降级为纯 BM25 检索；推荐硅基流动（BAAI/bge-m3 免费、中文效果好）
# EMBEDDING_API_KEY=sk-xxxxxxxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
